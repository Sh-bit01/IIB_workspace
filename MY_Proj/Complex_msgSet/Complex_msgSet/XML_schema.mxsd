<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
                
  
  
  
  
  
  
  
  <!-- Define the CustomerDetails complex type -->
                
  
  
  
  
  
  
  <xs:complexType name="CustomerDetailsType">
                                
    
        
    
                
    
    
    
    
    <xs:sequence>
                                                
      
      
      
      
      
      
      <xs:element name="CustomerName" type="xs:string"/>
                                                
      
      
      
      
      
      
      <xs:element name="CustomerAddress" type="xs:string"/>
                                              
    
    
    
    
    
    
    </xs:sequence>
                              
  
  
  
  
  
  
  </xs:complexType>
                
  
  
  
  
  
  
  <!-- Define the Item complex type -->
                
  
  
  
  
  
  
  <xs:complexType name="ItemType">
                                
    
        
    
                
    
    
    
    
    <xs:sequence>
                                                
      
      
      
      
      
      
      <xs:element minOccurs="1" name="ItemID" type="xs:string"/>
                                                
      
      
      
      
      
      
      <xs:element name="Description" type="xs:string"/>
                                                
      
      
      
      
      
      
      <xs:element name="Quantity" type="xs:int"/>
                                              
    
    
    
    
    
    
    </xs:sequence>
                              
  
  
  
  
  
  
  </xs:complexType>
                
  
  
  
  
  
  
  <!-- Define the Service complex type -->
                
  
  
  
  
  
  
  <xs:complexType name="ServiceType">
                                
    
        
    
                
    
    
    
    
    <xs:sequence>
                                                
      
      
      
      
      
      
      <xs:element name="ServiceID" type="xs:string"/>
                                                
      
      
      
      
      
      
      <xs:element name="ServiceDescription" type="xs:string"/>
                                                
      
      
      
      
      
      
      <xs:element name="Quantity" type="xs:int"/>
                                              
    
    
    
    
    
    
    </xs:sequence>
                              
  
  
  
  
  
  
  </xs:complexType>
                
  
  
  
  
  
  
  <!-- Define the OrderDetails complex type with a choice between ItemList or ServiceList -->
                
  
  
  
  
  
  
  <xs:complexType name="OrderDetailsType">
                                
    
        
    
    
                    
    
    
    
    
    <xs:sequence>
                                                
      
      
      
      
      
      
      <xs:choice>
                                                                
        
                
                        
        
        
        
        
        <xs:element name="ItemList">
                                                                                
          
          
          
          
          
          
          <xs:complexType>
                                                                                                
            
                        
            
            
            
            
            <xs:annotation>
                                                                      
              
              
              
              <xs:appinfo source="WMQI_APPINFO">
                <MRComplexType content="open"/>
              </xs:appinfo>
                                                                    
            
            
            
            </xs:annotation>
                                                                                    
            
            
            
            
            <xs:sequence>
                                                                                                                
              
              
              
              
              
              
              <xs:element maxOccurs="unbounded" name="Item" type="ItemType"/>
                                                                                                              
            
            
            
            
            
            
            </xs:sequence>
                                                                                              
          
          
          
          
          
          
          </xs:complexType>
                                                                              
        
        
        
        
        
        
        </xs:element>
                                                                
        
        
        
        
        
        
        <xs:element name="ServiceList">
                                                                                
          
          
          
          
          
          
          <xs:complexType>
                                                                                                
            
                        
            
            
            
            
            <xs:annotation>
                                                                      
              
              
              
              <xs:appinfo source="WMQI_APPINFO">
                <MRComplexType content="open"/>
              </xs:appinfo>
                                                                    
            
            
            
            </xs:annotation>
                                                                                    
            
            
            
            
            <xs:sequence>
                                                                                                                
              
              
              
              
              
              
              <xs:element maxOccurs="unbounded" name="Service" type="ServiceType"/>
                                                                                                              
            
            
            
            
            
            
            </xs:sequence>
                                                                                              
          
          
          
          
          
          
          </xs:complexType>
                                                                              
        
        
        
        
        
        
        </xs:element>
                                                              
      
      
      
      
      
      
      </xs:choice>
                                              
    
    
    
    
    
    
    </xs:sequence>
                              
  
  
  
  
  
  
  </xs:complexType>
                
  
  
  
  
  
  
  <!-- Define the main Order complex type -->
                
  
  
  
  
  
  
  <xs:complexType name="OrderType">
                                
    
        
    
    
    
                        
    
    
    
    
    <xs:sequence>
                                                
      
      
      
      
      
      
      <xs:element name="OrderID" type="xs:string"/>
                                                
      
      
      
      
      
      
      <xs:element name="CustomerDetails" type="CustomerDetailsType"/>
                                                
      
      
      
      
      
      
      <xs:element name="OrderDetails" type="OrderDetailsType"/>
                                                
      
      
      
      
      
      
      <xs:element name="OrderDate" type="xs:string"/>
                                              
    
    
    
    
    
    
    </xs:sequence>
                              
  
  
  
  
  
  
  </xs:complexType>
                
  
  
  
  
  
  
  <!-- Define the root element Order -->
                
  
  
  
  
  
  
  <xs:element name="Order" type="OrderType">
                            
    
    
    
    
    
    <xs:annotation>
                                          
      
      
      
      
      
      <xs:appinfo source="WMQI_APPINFO">
        <MRMessage messageDefinition="/0/Order;XSDElementDeclaration$MRObject"/>
      </xs:appinfo>
                                        
    
    
    
    
    
    </xs:annotation>
                          
  
  
  
  
  
  </xs:element>
              






</xs:schema>
