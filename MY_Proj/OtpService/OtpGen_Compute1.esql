

CREATE COMPUTE MODULE OtpGen_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot.JSON.Data.id = 142;
		SET OutputRoot = InputRoot;
		
		SET OutputRoot.JSON.Data.otp =  otpgen();
	END;
END MODULE;


CREATE PROCEDURE otpgen() returns CHARACTER
LANGUAGE JAVA
EXTERNAL NAME "otp.optMapping.generateOTP";







