







CREATE COMPUTE MODULE OtpGen_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN FALSE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		DECLARE id CHARACTER InputRoot.JSON.Data.id;
		DECLARE mail CHARACTER;
		CALL getmail(id, mail);
		SET OutputRoot.EmailOutputHeader.To = mail;
		SET OutputRoot.EmailOutputHeader.From = 'shreyash@test.com';
		--SET OutputRoot.EmailOutputHeader.Subject = InputRoot.JSON.Data.mail.subject;
		SET OutputRoot.EmailOutputHeader.Subject = 'OTP ';
		--SET OutputLocalEnvironment.Destination.Email.SMTPServer ='192.168.2.21:25';

		DECLARE cha CHARACTER;

		SET cha = 'Your One Time Password (OTP) is ' || InputRoot.JSON.Data.otp || '. Do Not Share It......' ;

		SET OutputRoot.BLOB.BLOB = CAST(cha AS BLOB CCSID 1208);

		Propagate TO TERMINAL 'out1';

		SET OutputRoot = NULL;

		SET OutputRoot = InputRoot;
		SET OutputRoot.JSON.Data.message.info = 'Mail is sent....';

		DELETE FIELD OutputRoot.JSON.Data.otp;
		SET OutputRoot.HTTPInputHeader."Content-Type"= 'application/json';
		Propagate TO TERMINAL 'out';
	END;
END MODULE;



CREATE PROCEDURE getmail (IN id CHARACTER, OUT Mail CHARACTER )
LANGUAGE DATABASE
EXTERNAL NAME "get_email";