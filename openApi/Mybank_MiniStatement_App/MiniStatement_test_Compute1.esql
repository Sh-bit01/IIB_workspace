PATH test;

CREATE COMPUTE MODULE MiniStatement_test_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		--CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		---------------------Backend_res logging ----------------------------
		DECLARE cssid REFERENCE TO InputRoot.Properties.CodedCharSetId;
		DECLARE Encoding REFERENCE TO InputRoot.Properties.Encoding;
		DECLARE incoming CHARACTER cast(ASBITSTREAM(InputRoot.XMLNSC CCSID cssid ENCODING Encoding) as CHARACTER CCSID cssid ENCODING Encoding);
		--MSG_ID, LOGGINGTIME, MESSAGE_DATA, MESSAGE_TYPE, APP_NAME, BROKER_NAME, RETRIEVAL_REFERENCE_NUMBER, LOG_POINT
		DECLARE REFERENCE_NUMBER CHARACTER Environment.InputRoot.MiniStatementRequest.ESBHeader.Message_Id;
		CALL DbLogging(CURRENT_TIMESTAMP, ApplicationLabel ,BrokerName, REFERENCE_NUMBER, 'Backend Responce', incoming);
		------------------------------END Log--------------------------------

		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE NEXTSIBLING OF OutputRoot.Properties DOMAIN('MQMD');
		SET OutputRoot.MQMD = Environment.Variables.MQMD;
		SET OutputRoot.JSON.Data = InputRoot.XMLNSC;

		---------------------Channal_res logging ----------------------------
		--DECLARE msg_id REFERENCE TO InputLocalEnvironment.Destination.HTTP.RequestIdentifier;
		DECLARE outgoing CHARACTER CAST(ASBITSTREAM(OutputRoot.JSON CCSID cssid ENCODING Encoding) as CHARACTER CCSID cssid ENCODING Encoding);
		--MSG_ID, LOGGINGTIME, MESSAGE_DATA, MESSAGE_TYPE, APP_NAME, BROKER_NAME, RETRIEVAL_REFERENCE_NUMBER, LOG_POINT
		CALL DbLogging(CURRENT_TIMESTAMP, ApplicationLabel ,BrokerName,REFERENCE_NUMBER, 'Channel Responce', outgoing);
		------------------------------END Log--------------------------------

	END;
END MODULE;

CREATE PROCEDURE DbLogging (IN LOGGINGTIME TIMESTAMP, IN APP_NAME CHARACTER, IN BROKER_NAME CHARACTER, IN RETRIEVAL_REFERENCE_NUMBER CHARACTER, IN LOG_POINT CHARACTER, In payload CHARACTER)
LANGUAGE DATABASE
EXTERNAL NAME "InsertAuditLog"; 