
CREATE COMPUTE MODULE mainflow_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE vault CHARACTER '';

		IF CONTAINS(InputRoot.HTTPInputHeader.Authorization, 'Basic') THEN
			DECLARE v CHARACTER SUBSTRING(InputRoot.HTTPInputHeader.Authorization FROM 7);
			SET vault = CAST(BASE64DECODE(v) AS CHARACTER CCSID 1208);

		END IF;

		DECLARE uname CHARACTER SUBSTRING(vault BEFORE ':');
		DECLARE pass CHARACTER SUBSTRING(vault AFTER ':');


		IF pass = 'sarasu10' THEN
			CASE uname
			WHEN 'bob' THEN
				SET OutputRoot.JSON.Data.response = 'Hi bob from IIB';
			WHEN 'root' THEN
				SET OutputRoot.JSON.Data.response = 'Hi root from IIB';
			WHEN 'test' THEN
				SET OutputRoot.JSON.Data.response = 'Hi test from IIB';
			WHEN 'shreyash' THEN
				SET OutputRoot.JSON.Data.response = 'Hi shreyash from IIB';
			WHEN 'ashar' THEN
				SET OutputRoot.JSON.Data.response = 'Hi ashar from IIB';
			WHEN 'bhargav' THEN
				SET OutputRoot.JSON.Data.response = 'Hi bhargav from IIB';
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = 401;
				SET OutputRoot.JSON.Data.response = 'Unauthorized: Unknown user';
			END CASE;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = 401;
			SET OutputRoot.JSON.Data.response = 'Unauthorized: Invalid password';
		END IF;
	END;
END MODULE;