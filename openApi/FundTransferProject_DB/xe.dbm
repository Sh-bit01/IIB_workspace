    <source xmi:id="_VyBXDdiCEe-eifwhJZ8PzA" body="CREATE PROCEDURE AUDIT_LOG_P(&#xA;CUSTOMER_ID IN VARCHAR2,&#xA;PAYLOAD IN VARCHAR2,&#xA;PAYLOAD_TYPE IN VARCHAR2,&#xA;SOURCE_SYSTEM IN VARCHAR2,&#xA;TRANSACTION_TYPE IN VARCHAR2,&#xA;CREATED_ON IN TIMESTAMP&#xA;&#xA;) AS &#xA;BEGIN&#xA;  INSERT INTO AUDIT_LOG VALUES (CUSTOMER_ID,PAYLOAD,PAYLOAD_TYPE,SOURCE_SYSTEM,TRANSACTION_TYPE,CREATED_ON);&#xA;END AUDIT_LOG_P;"/>
