  <SQLTables:Trigger xmi:id="_xU9prNcxEe-nVrEo9gHejQ" name="DEF$_PROPAGATOR_TRIG" schema="_xU6mUNcxEe-nVrEo9gHejQ" subjectTable="_xU9pr9cxEe-nVrEo9gHejQ" actionTime="BEFORE" insertType="true" oldRow="OLD" newRow="NEW">
    <dependencies xmi:id="_xU9prdcxEe-nVrEo9gHejQ" targetEnd="_xU9pr9cxEe-nVrEo9gHejQ"/>
    <actionStatement xsi:type="SQLStatements:SQLStatementDefault" xmi:id="_xU9prtcxEe-nVrEo9gHejQ" SQL="DECLARE&#xA;  prop_count  NUMBER;&#xA;BEGIN&#xA;  SELECT count(*) into prop_count&#xA;    FROM system.def$_propagator;&#xA;&#xA;  IF (prop_count > 0) THEN&#xA;    -- Raise duplicate propagator error&#xA;    sys.dbms_sys_error.raise_system_error(-23394);&#xA;  END IF;&#xA;END;"/>
  </SQLTables:Trigger>
