  <SQLTables:Trigger xmi:id="_VxM3ntiCEe-eifwhJZ8PzA" name="DEF$_PROPAGATOR_TRIG" schema="_VxLpYNiCEe-eifwhJZ8PzA" subjectTable="_VxM3odiCEe-eifwhJZ8PzA" actionTime="BEFORE" insertType="true" oldRow="OLD" newRow="NEW">
    <dependencies xmi:id="_VxM3n9iCEe-eifwhJZ8PzA" targetEnd="_VxM3odiCEe-eifwhJZ8PzA"/>
    <actionStatement xsi:type="SQLStatements:SQLStatementDefault" xmi:id="_VxM3oNiCEe-eifwhJZ8PzA" SQL="DECLARE&#xA;  prop_count  NUMBER;&#xA;BEGIN&#xA;  SELECT count(*) into prop_count&#xA;    FROM system.def$_propagator;&#xA;&#xA;  IF (prop_count > 0) THEN&#xA;    -- Raise duplicate propagator error&#xA;    sys.dbms_sys_error.raise_system_error(-23394);&#xA;  END IF;&#xA;END;"/>
  </SQLTables:Trigger>
