      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVgcW9cxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="30"/>
    </columns>
    <columns xmi:id="_xVgcXNcxEe-nVrEo9gHejQ" name="STORAGE_IN_BYTES">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xVgcXdcxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
    <columns xmi:id="_xVgcXtcxEe-nVrEo9gHejQ" name="PCT_PERFORMANCE_GAIN">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xVgcX9cxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
    <columns xmi:id="_xVgcYNcxEe-nVrEo9gHejQ" name="BENEFIT_TO_COST_RATIO" nullable="false">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xVgcYdcxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
    <queryExpression xsi:type="SQLExpressions:QueryExpressionDefault" xmi:id="_xVgcYtcxEe-nVrEo9gHejQ" SQL="select&#xA;  t1.runid# as runid,&#xA;  t1.from_clause as all_tables,&#xA;  fact_tables,&#xA;  grouping_levels,&#xA;  query_text,&#xA;  rank# as recommendation_number,&#xA;  action_type as recommended_action,&#xA;  summary_owner as mview_owner,&#xA;  summary_name as mview_name,&#xA;  storage_in_bytes,&#xA;  pct_performance_gain,&#xA;  benefit_to_cost_ratio&#xA;from SYSTEM.MVIEW$_ADV_OUTPUT t1, SYSTEM.MVIEW$_ADV_LOG t2, ALL_USERS u&#xA;where&#xA;  t1.runid# = t2.runid# and&#xA;  u.username = t2.uname and&#xA;  u.user_id = userenv('SCHEMAID') and&#xA;  t1.output_type = 0&#xA;order by t1.rank#"/>
  </SQLTables:ViewTable>
