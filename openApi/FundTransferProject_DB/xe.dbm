    <source xmi:id="_xViRo9cxEe-nVrEo9gHejQ" body="CREATE PROCEDURE DBLOGGINGPROC &#xA;(&#xA;  REQUISTID IN VARCHAR2 &#xA;, PAYLOADTYPE IN VARCHAR2 &#xA;, TIMESTAMPS IN TIMESTAMP &#xA;, PAYLOAD IN VARCHAR2 &#xA;) AS &#xA;BEGIN&#xA;  INSERT into DBLOGGING VALUES (REQUISTID,PAYLOADTYPE,TIMESTAMPS,PAYLOAD);&#xA;END DBLOGGINGPROC;"/>
  </SQLRoutines:Procedure>
  <SQLRoutines:Procedure xmi:id="_xViRpNcxEe-nVrEo9gHejQ" name="TRANSFERBALANCE" language="SQL" creationTS="2025-01-07:18:53:20" schema="_xU6mUNcxEe-nVrEo9gHejQ">
    <dependencies xmi:id="_xViRpdcxEe-nVrEo9gHejQ" targetEnd="_xU70cNcxEe-nVrEo9gHejQ"/>
    <parameters xmi:id="_xViRptcxEe-nVrEo9gHejQ" name="P_FROMCUSTOMERID">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xViRp9cxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </parameters>
    <parameters xmi:id="_xViRqNcxEe-nVrEo9gHejQ" name="P_TOCUSTOMERID">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xViRqdcxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </parameters>
    <parameters xmi:id="_xViRqtcxEe-nVrEo9gHejQ" name="P_AMOUNT">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xViRq9cxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </parameters>
    <source xmi:id="_xViRrNcxEe-nVrEo9gHejQ" body="CREATE PROCEDURE TransferBalance(&#xA;    p_FromCustomerID NUMBER,&#xA;    p_ToCustomerID NUMBER,&#xA;    p_Amount NUMBER&#xA;) AS&#xA;    v_FromTotalBalance NUMBER(15, 2);&#xA;    v_ToTotalBalance NUMBER(15, 2);&#xA;BEGIN&#xA;    -- Fetch the current total balance for the sender&#xA;    SELECT TotalBalance INTO v_FromTotalBalance&#xA;    FROM CentralCustomerDB&#xA;    WHERE CardID = p_FromCustomerID;&#xA;&#xA;    -- Fetch the current total balance for the receiver&#xA;    SELECT TotalBalance INTO v_ToTotalBalance&#xA;    FROM CentralCustomerDB&#xA;    WHERE CardID = p_ToCustomerID;&#xA;&#xA;    -- Check if the sender has sufficient balance&#xA;    IF v_FromTotalBalance - p_Amount &lt; 0 THEN&#xA;        RAISE_APPLICATION_ERROR(-20001, 'Insufficient funds for transfer operation.');&#xA;    END IF;&#xA;&#xA;    -- Update the balances&#xA;    v_FromTotalBalance := v_FromTotalBalance - p_Amount; -- Debit from sender&#xA;    v_ToTotalBalance := v_ToTotalBalance + p_Amount;     -- Credit to receiver&#xA;&#xA;    -- Update the sender's balance&#xA;    UPDATE CentralCustomerDB&#xA;    SET TotalBalance = v_FromTotalBalance&#xA;    WHERE CardID = p_FromCustomerID;&#xA;&#xA;    -- Update the receiver's balance&#xA;    UPDATE CentralCustomerDB&#xA;    SET TotalBalance = v_ToTotalBalance&#xA;    WHERE CardID = p_ToCustomerID;&#xA;&#xA;    COMMIT; -- Commit the transaction&#xA;EXCEPTION&#xA;    WHEN NO_DATA_FOUND THEN&#xA;        RAISE_APPLICATION_ERROR(-20002, 'Customer ID not found.');&#xA;END TransferBalance;&#xA;"/>
  </SQLRoutines:Procedure>
</xmi:XMI>
