    <source xmi:id="_MBSImtexEe-nVrEo9gHejQ" body="CREATE PROCEDURE DBLOGGINGPROC &#xA;(&#xA;  REQUISTID IN VARCHAR2 &#xA;, PAYLOADTYPE IN VARCHAR2 &#xA;, TIMESTAMPS IN TIMESTAMP &#xA;, PAYLOAD IN VARCHAR2 &#xA;) AS &#xA;BEGIN&#xA;  INSERT into DBLOGGING VALUES (REQUISTID,PAYLOADTYPE,TIMESTAMPS,PAYLOAD);&#xA;END DBLOGGINGPROC;"/>
