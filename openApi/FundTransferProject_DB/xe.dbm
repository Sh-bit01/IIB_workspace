    <source xmi:id="_MBRhrNexEe-nVrEo9gHejQ" body="CREATE PROCEDURE InsertAuditLog(&#xA;    p_loggingtime TIMESTAMP,&#xA;    p_app_name VARCHAR2,&#xA;    p_broker_name VARCHAR2,&#xA;    p_retrieval_reference_number VARCHAR2,&#xA;    p_log_point VARCHAR2,&#xA;    p_payload CLOB&#xA;) AS&#xA;BEGIN&#xA;    INSERT INTO &quot;SYSTEM&quot;.&quot;RAW_AUDIT_LOGGING&quot; (&#xA;        &quot;LOGGINGTIME&quot;,&#xA;        &quot;APP_NAME&quot;,&#xA;        &quot;BROKER_NAME&quot;,&#xA;        &quot;RETRIEVAL_REFERENCE_NUMBER&quot;,&#xA;        &quot;LOG_POINT&quot;,&#xA;        &quot;PAYLOAD&quot;&#xA;    ) VALUES (&#xA;        p_loggingtime,&#xA;        p_app_name,&#xA;        p_broker_name,&#xA;        p_retrieval_reference_number,&#xA;        p_log_point,&#xA;        p_payload&#xA;    );&#xA;    COMMIT;&#xA;END InsertAuditLog;"/>
  </SQLRoutines:Procedure>
  <SQLRoutines:Procedure xmi:id="_MBSIkNexEe-nVrEo9gHejQ" name="DBLOGGINGPROC" language="SQL" creationTS="2025-01-07:16:24:41" schema="_MAh6oNexEe-nVrEo9gHejQ">
