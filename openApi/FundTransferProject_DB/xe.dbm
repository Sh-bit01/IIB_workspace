    <queryExpression xsi:type="SQLExpressions:QueryExpressionDefault" xmi:id="_MBPFWdexEe-nVrEo9gHejQ" SQL="SELECT PRODUCT, USERID, ATTRIBUTE, SCOPE,&#xA;         NUMERIC_VALUE, CHAR_VALUE, DATE_VALUE, LONG_VALUE&#xA;  FROM SQLPLUS_PRODUCT_PROFILE&#xA;  WHERE USERID = 'PUBLIC' OR USER LIKE USERID"/>
