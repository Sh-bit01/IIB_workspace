    </parameters>
    <parameters xmi:id="_xViRn9cxEe-nVrEo9gHejQ" name="TIMESTAMPS">
      <containedType xsi:type="SQLDataTypes:TimeDataType" xmi:id="_xViRoNcxEe-nVrEo9gHejQ" name="TIMESTAMP" primitiveType="TIMESTAMP" fractionalSecondsPrecision="6"/>
