  <SQLRoutines:Procedure xmi:id="_MBRhm9exEe-nVrEo9gHejQ" name="AUDIT_LOG_P" language="SQL" creationTS="2025-01-20:18:29:11" schema="_MAh6oNexEe-nVrEo9gHejQ">
    <dependencies xmi:id="_MBRhnNexEe-nVrEo9gHejQ" targetEnd="_MBKNIdexEe-nVrEo9gHejQ"/>
    <source xmi:id="_MBRhndexEe-nVrEo9gHejQ" body="CREATE PROCEDURE AUDIT_LOG_P(&#xA;CUSTOMER_ID IN VARCHAR2,&#xA;PAYLOAD IN VARCHAR2,&#xA;PAYLOAD_TYPE IN VARCHAR2,&#xA;SOURCE_SYSTEM IN VARCHAR2,&#xA;TRANSACTION_TYPE IN VARCHAR2,&#xA;CREATED_ON IN TIMESTAMP&#xA;&#xA;) AS &#xA;BEGIN&#xA;  INSERT INTO audit_log VALUES (CUSTOMER_ID,PAYLOAD,PAYLOAD_TYPE,SOURCE_SYSTEM,TRANSACTION_TYPE,CREATED_ON);&#xA;END AUDIT_LOG_P;"/>
  </SQLRoutines:Procedure>
  <SQLRoutines:Procedure xmi:id="_MBRhntexEe-nVrEo9gHejQ" name="INSERTAUDITLOG" language="SQL" creationTS="2025-01-07:10:37:06" schema="_MAh6oNexEe-nVrEo9gHejQ">
