  <SQLRoutines:Procedure xmi:id="_xViRh9cxEe-nVrEo9gHejQ" name="AUDIT_LOG_P" language="SQL" creationTS="2025-01-20:18:29:11" schema="_xU6mUNcxEe-nVrEo9gHejQ">
    <dependencies xmi:id="_xViRiNcxEe-nVrEo9gHejQ" targetEnd="_xVdY5NcxEe-nVrEo9gHejQ"/>
    <source xmi:id="_xViRidcxEe-nVrEo9gHejQ" body="CREATE PROCEDURE AUDIT_LOG_P(&#xA;CUSTOMER_ID IN VARCHAR2,&#xA;PAYLOAD IN VARCHAR2,&#xA;PAYLOAD_TYPE IN VARCHAR2,&#xA;SOURCE_SYSTEM IN VARCHAR2,&#xA;TRANSACTION_TYPE IN VARCHAR2,&#xA;CREATED_ON IN TIMESTAMP&#xA;&#xA;) AS &#xA;BEGIN&#xA;  INSERT INTO audit_log VALUES (CUSTOMER_ID,PAYLOAD,PAYLOAD_TYPE,SOURCE_SYSTEM,TRANSACTION_TYPE,CREATED_ON);&#xA;END AUDIT_LOG_P;"/>
  </SQLRoutines:Procedure>
