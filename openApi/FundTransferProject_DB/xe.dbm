      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVgcV9cxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="6"/>
    </columns>
