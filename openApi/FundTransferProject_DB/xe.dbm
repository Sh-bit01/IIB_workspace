  <SQLRoutines:Procedure xmi:id="_MBSIm9exEe-nVrEo9gHejQ" name="TRANSFERBALANCE" language="SQL" creationTS="2025-01-20:19:09:23" schema="_MAh6oNexEe-nVrEo9gHejQ">
    <dependencies xmi:id="_MBSInNexEe-nVrEo9gHejQ" targetEnd="_MAihtNexEe-nVrEo9gHejQ"/>
    <parameters xmi:id="_MBSIndexEe-nVrEo9gHejQ" name="P_FROMCUSTOMERID">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_MBSIntexEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </parameters>
    <parameters xmi:id="_MBSIn9exEe-nVrEo9gHejQ" name="P_TOCUSTOMERID">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_MBSIoNexEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </parameters>
    <parameters xmi:id="_MBSIodexEe-nVrEo9gHejQ" name="P_AMOUNT">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_MBSIotexEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </parameters>
    <parameters xmi:id="_MBSIo9exEe-nVrEo9gHejQ" name="P_STATUS" mode="OUT">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_MBSIpNexEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING"/>
    </parameters>
    <parameters xmi:id="_MBSIpdexEe-nVrEo9gHejQ" name="P_MESSAGE" mode="OUT">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_MBSIptexEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING"/>
    </parameters>
    <source xmi:id="_MBSIp9exEe-nVrEo9gHejQ" body="CREATE PROCEDURE TransferBalance(&#xA;    p_FromCustomerID NUMBER,&#xA;    p_ToCustomerID NUMBER,&#xA;    p_Amount NUMBER,&#xA;    p_Status OUT VARCHAR2,          -- For success or failure status&#xA;    p_Message OUT VARCHAR2          -- For detailed message&#xA;) AS&#xA;    v_FromTotalBalance NUMBER(15, 2);&#xA;    v_ToTotalBalance NUMBER(15, 2);&#xA;BEGIN&#xA;    -- Fetch the current total balance for the sender&#xA;    SELECT TotalBalance INTO v_FromTotalBalance&#xA;    FROM CentralCustomerDB&#xA;    WHERE CardID = p_FromCustomerID;&#xA;&#xA;    -- Fetch the current total balance for the receiver&#xA;    SELECT TotalBalance INTO v_ToTotalBalance&#xA;    FROM CentralCustomerDB&#xA;    WHERE CardID = p_ToCustomerID;&#xA;&#xA;    -- Check if the sender has sufficient balance&#xA;    IF v_FromTotalBalance - p_Amount &lt; 0 THEN&#xA;        p_Status := 'Failure';&#xA;        p_Message := 'Insufficient funds for transfer operation.';&#xA;        RETURN;&#xA;    END IF;&#xA;&#xA;    -- Update the balances&#xA;    v_FromTotalBalance := v_FromTotalBalance - p_Amount; -- Debit from sender&#xA;    v_ToTotalBalance := v_ToTotalBalance + p_Amount;     -- Credit to receiver&#xA;&#xA;    -- Update the sender's balance&#xA;    UPDATE CentralCustomerDB&#xA;    SET TotalBalance = v_FromTotalBalance&#xA;    WHERE CardID = p_FromCustomerID;&#xA;&#xA;    -- Update the receiver's balance&#xA;    UPDATE CentralCustomerDB&#xA;    SET TotalBalance = v_ToTotalBalance&#xA;    WHERE CardID = p_ToCustomerID;&#xA;&#xA;    COMMIT; -- Commit the transaction&#xA;&#xA;    -- Set success status and message&#xA;    p_Status := 'Success';&#xA;    p_Message := 'Transfer completed successfully.';&#xA;EXCEPTION&#xA;    WHEN NO_DATA_FOUND THEN&#xA;        p_Status := 'Failure';&#xA;        p_Message := 'Customer ID not found.';&#xA;    WHEN OTHERS THEN&#xA;        p_Status := 'Failure';&#xA;        p_Message := 'An unexpected error occurred: ' || SQLERRM;&#xA;END TransferBalance;"/>
  </SQLRoutines:Procedure>
</xmi:XMI>
