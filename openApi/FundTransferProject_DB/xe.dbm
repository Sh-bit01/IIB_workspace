  <OracleModel:OracleTable xmi:id="_xVbj59cxEe-nVrEo9gHejQ" name="REPCAT$_RESOLUTION_STATISTICS" description="Statistics for conflict resolutions for all replicated tables in the database" schema="_xU6mUNcxEe-nVrEo9gHejQ" index="_xVbj3dcxEe-nVrEo9gHejQ" PCTFree="10" PCTUsed="40" initTrans="1" maxTrans="255">
    <columns xmi:id="_xVbj6NcxEe-nVrEo9gHejQ" name="SNAME" description="Owner of replicated object" nullable="false">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj6dcxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="30"/>
    </columns>
    <columns xmi:id="_xVbj6tcxEe-nVrEo9gHejQ" name="ONAME" description="Name of the replicated object" nullable="false">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj69cxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="30"/>
    </columns>
    <columns xmi:id="_xVbj7NcxEe-nVrEo9gHejQ" name="CONFLICT_TYPE_ID" description="Type of conflict" nullable="false">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xVbj7dcxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
    <columns xmi:id="_xVbj7tcxEe-nVrEo9gHejQ" name="REFERENCE_NAME" description="Table name, unique constraint name, or column group name" nullable="false">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj79cxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="30"/>
    </columns>
    <columns xmi:id="_xVbj8NcxEe-nVrEo9gHejQ" name="METHOD_NAME" description="Name of the conflict resolution method" nullable="false">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj8dcxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="80"/>
    </columns>
    <columns xmi:id="_xVbj8tcxEe-nVrEo9gHejQ" name="FUNCTION_NAME" description="Name of the resolution function" nullable="false">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj89cxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="92"/>
    </columns>
    <columns xmi:id="_xVbj9NcxEe-nVrEo9gHejQ" name="PRIORITY_GROUP" description="Name of the priority group used in conflict resolution">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj9dcxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="30"/>
    </columns>
    <columns xmi:id="_xVbj9tcxEe-nVrEo9gHejQ" name="RESOLVED_DATE" description="Timestamp for the resolution of the conflict" nullable="false">
      <containedType xsi:type="SQLDataTypes:DateDataType" xmi:id="_xVbj99cxEe-nVrEo9gHejQ" name="DATE" primitiveType="DATE"/>
    </columns>
    <columns xmi:id="_xVbj-NcxEe-nVrEo9gHejQ" name="PRIMARY_KEY_VALUE" description="Primary key of the replicated row (character data)" nullable="false">
      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_xVbj-dcxEe-nVrEo9gHejQ" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="2000"/>
    </columns>
    <constraints xsi:type="SQLConstraints:CheckConstraint" xmi:id="_xVbj-tcxEe-nVrEo9gHejQ" name="REPCAT$_RESOLUTION_STATS_NN1">
      <searchCondition xsi:type="SQLExpressions:SearchConditionDefault" xmi:id="_xVbj-9cxEe-nVrEo9gHejQ" SQL="&quot;SNAME&quot; IS NOT NULL"/>
    </constraints>
    <constraints xsi:type="SQLConstraints:CheckConstraint" xmi:id="_xVbj_NcxEe-nVrEo9gHejQ" name="REPCAT$_RESOLUTION_STATS_NN2">
      <searchCondition xsi:type="SQLExpressions:SearchConditionDefault" xmi:id="_xVbj_dcxEe-nVrEo9gHejQ" SQL="&quot;ONAME&quot; IS NOT NULL"/>
    </constraints>
    <constraints xsi:type="SQLConstraints:CheckConstraint" xmi:id="_xVbj_tcxEe-nVrEo9gHejQ" name="REPCAT$_RESOLUTION_STATS_NN3">
      <searchCondition xsi:type="SQLExpressions:SearchConditionDefault" xmi:id="_xVbj_9cxEe-nVrEo9gHejQ" SQL="&quot;CONFLICT_TYPE_ID&quot; IS NOT NULL"/>
    </constraints>
    <constraints xsi:type="SQLConstraints:CheckConstraint" xmi:id="_xVbkANcxEe-nVrEo9gHejQ" name="REPCAT$_RESOLUTION_STATS_NN4">
      <searchCondition xsi:type="SQLExpressions:SearchConditionDefault" xmi:id="_xVbkAdcxEe-nVrEo9gHejQ" SQL="&quot;REFERENCE_NAME&quot; IS NOT NULL"/>
    </constraints>
    <constraints xsi:type="SQLConstraints:CheckConstraint" xmi:id="_xVbkAtcxEe-nVrEo9gHejQ" name="REPCAT$_RESOLUTION_STATS_NN5">
