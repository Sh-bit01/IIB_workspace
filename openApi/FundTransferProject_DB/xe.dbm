      <containedType xsi:type="SQLDataTypes:CharacterStringDataType" xmi:id="_Vx-TmtiCEe-eifwhJZ8PzA" name="VARCHAR2" primitiveType="CHARACTER_VARYING" length="1028"/>
    </columns>
    <columns xmi:id="_Vx-Tm9iCEe-eifwhJZ8PzA" name="NUM_VALUE1">
