  <SQLTables:Trigger xmi:id="_MAjv09exEe-nVrEo9gHejQ" name="DEF$_PROPAGATOR_TRIG" schema="_MAh6oNexEe-nVrEo9gHejQ" subjectTable="_MAjv1texEe-nVrEo9gHejQ" actionTime="BEFORE" insertType="true" oldRow="OLD" newRow="NEW">
    <dependencies xmi:id="_MAjv1NexEe-nVrEo9gHejQ" targetEnd="_MAjv1texEe-nVrEo9gHejQ"/>
    <actionStatement xsi:type="SQLStatements:SQLStatementDefault" xmi:id="_MAjv1dexEe-nVrEo9gHejQ" SQL="DECLARE&#xA;  prop_count  NUMBER;&#xA;BEGIN&#xA;  SELECT count(*) into prop_count&#xA;    FROM system.def$_propagator;&#xA;&#xA;  IF (prop_count > 0) THEN&#xA;    -- Raise duplicate propagator error&#xA;    sys.dbms_sys_error.raise_system_error(-23394);&#xA;  END IF;&#xA;END;"/>
  </SQLTables:Trigger>
