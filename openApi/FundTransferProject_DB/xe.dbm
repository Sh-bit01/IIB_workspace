    </columns>
    <columns xmi:id="_xVgcQNcxEe-nVrEo9gHejQ" name="COMPLETED">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_xVgcQdcxEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
