    </columns>
    <columns xmi:id="_Vx-T59iCEe-eifwhJZ8PzA" name="PCT_PERFORMANCE_GAIN">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_Vx-T6NiCEe-eifwhJZ8PzA" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
    <columns xmi:id="_Vx-T6diCEe-eifwhJZ8PzA" name="BENEFIT_TO_COST_RATIO" nullable="false">
