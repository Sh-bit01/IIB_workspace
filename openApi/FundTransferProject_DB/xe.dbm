    </columns>
    <columns xmi:id="_MBOeadexEe-nVrEo9gHejQ" name="COMPLETED">
      <containedType xsi:type="SQLDataTypes:FixedPrecisionDataType" xmi:id="_MBOeatexEe-nVrEo9gHejQ" name="NUMBER" primitiveType="NUMERIC"/>
    </columns>
