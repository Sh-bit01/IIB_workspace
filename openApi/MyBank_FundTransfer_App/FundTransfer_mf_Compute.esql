



DECLARE MNSTMTBackendURL EXTERNAL CHARACTER'';
DECLARE ft NAMESPACE 'http://www.example.org/Fund_Transfer_Wsdl/';
--DECLARE ns NAMESPACE 'http://www.example.org/Fund_Transfer_Wsdl/';
DECLARE soapenv NAMESPACE'';
DECLARE ns1 NAMESPACE'';

CREATE COMPUTE MODULE FundTransfer_mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN FALSE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		SET Environment.InputRoot = InputRoot.JSON.Data;
		SET Environment.MQRFH2= InputRoot.MQRFH2;

		DECLARE reqMsg,bindingOperatingName CHARACTER '';
		DECLARE rc BOOLEAN FALSE;
		DECLARE ccsid INTEGER InputRoot.Properties.CodedCharSetId ;
		DECLARE encodeRef INTEGER InputRoot.Properties.Encoding;
		DECLARE inRef REFERENCE TO InputRoot.JSON.Data;

		DECLARE outRefer REFERENCE TO OutputRoot;

		CREATE LASTCHILD OF OutputRoot DOMAIN 'SOAP';
		DECLARE outRefSoap REFERENCE TO OutputRoot.SOAP;
		DECLARE inrefData REFERENCE TO inRef.FundTransferRequest.FundTransferTransactionType;
		SET outRefSoap.Context.Namespace.soapenv = 'http://schemas.xmlsoap.org/soap/envelope/';
		SET outRefSoap.Context.Namespace.ft = 'http://www.example.org/Fund_Transfer_Wsdl/';
		SET outRefSoap.Context.XmlRoot.Envelope.Header = '';
		SET outRefSoap.Context.XmlRoot.Envelope.Body = '';
		SET outRefSoap.Header = '';
		
		--data Add Heder
		SET outRefer.Body.ft:FundTransferRequest.WebRequestCommon.company = inRef.FundTransferRequest.WebRequestCommon.company;
		SET outRefer.Body.ft:FundTransferRequest.WebRequestCommon.password = inRef.FundTransferRequest.WebRequestCommon.password;
		SET outRefer.Body.ft:FundTransferRequest.WebRequestCommon.userName = inRef.FundTransferRequest.WebRequestCommon.userName;
		
		--Data add Transfer
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.TRXID = inRef.FundTransferRequest.FundTransferTransactionType.TRXID;
		
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.DebitAccount.AccountNumber = inRef.FundTransferRequest.FundTransferTransactionType.DebitAccount.AccountNumber;
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.DebitAccount.AccountType = inRef.FundTransferRequest.FundTransferTransactionType.DebitAccount.AccountType;
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.DebitAccount.AccountHolderName = inRef.FundTransferRequest.FundTransferTransactionType.DebitAccount.AccountHolderName;
		
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.CreditAccount.AccountNumber = inRef.FundTransferRequest.FundTransferTransactionType.CreditAccount.AccountNumber;
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.CreditAccount.AccountType = inRef.FundTransferRequest.FundTransferTransactionType.CreditAccount.AccountType;
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.CreditAccount.AccountHolderName = inRef.FundTransferRequest.FundTransferTransactionType.CreditAccount.AccountHolderName;
		
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.Amount = inRef.FundTransferRequest.Amount;
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.TransactionDate = inRef.FundTransferRequest.TransactionDate;
		SET outRefer.Body.ft:FundTransferRequest.FundTransferTransctionType.TransactionDescription = inRef.FundTransferRequest.TransactionDescription;
		



		SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.WebServiceURL = 'MNSTMTBackendURL';
		SET Environment.MQMD = InputRoot.MQMD;

		PROPAGATE TO TERMINAL 'out';

	END;
END MODULE;




























