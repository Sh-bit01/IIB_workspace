CREATE COMPUTE MODULE MiniStatementFlow_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		CREATE LASTCHILD OF OutputRoot DOMAIN ('XMLNSC');
		SET OutputRoot.XMLNSC.LoggingDetails.data[1].ref_no = '';
		SET OutputRoot.XMLNSC.LoggingDetails.data[1].LOG_POINT = '';
		SET OutputRoot.XMLNSC.LoggingDetails.data[1].data = '';


		SET Environment.Data = InputRoot.XMLNSC.ns4:BankStatmtResponse;
		--CREATE LASTCHILD OF OutputRoot DOMAIN ('MQMD');
		--SET OutputRoot.MQMD = Environment.MQMD;
		SET OutputRoot.JSON.Data.BankStatmtResponse = Environment.Data;
		DELETE FIRSTCHILD OF OutputRoot.JSON.Data.BankStatmtResponse;		
		
		


		SET OutputRoot.XMLNSC.LoggingDetails.data[2].ref_no = '';
		SET OutputRoot.XMLNSC.LoggingDetails.data[2].LOG_POINT = '';
		SET OutputRoot.XMLNSC.LoggingDetails.data[2].data = '';

		SET Environment.JSON = OutputRoot.JSON;
		DELETE LASTCHILD OF OutputRoot;

		propagate TO TERMINAL 'out1';

		DELETE LASTCHILD OF OutputRoot;
		CREATE LASTCHILD OF OutputRoot DOMAIN ('JSON');
		SET OutputRoot.JSON = Environment.JSON;



	END;
END MODULE;