DECLARE ns4 NAMESPACE 'http://www.example.org/Bank_Statament/';



CREATE COMPUTE MODULE T24_MiniStanment_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

		CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		
		DECLARE accNo INTEGER InputRoot.SOAP.Body.ns4:BankStatmtReq.AccountNo;
		DECLARE status, msg CHARACTER;
		CALL stament(accNo, status, msg, Environment.res[]);
		
		SET OutputRoot.SOAP.Body.ns4:BankStatmtResponse.Status = status;
		SET OutputRoot.SOAP.Body.ns4:BankStatmtResponse.Message = msg;
		SET OutputRoot.SOAP.Body.ns4:BankStatmtResponse.AccountNumber = accNo;
		SET OutputRoot.SOAP.Body.ns4:BankStatmtResponse.Statement[] = Environment.res[];
		 
		
		
		
	END;
END MODULE;


CREATE PROCEDURE stament(IN accoutNo INTEGER, OUT status CHARACTER, OUT msg CHARACTER)
LANGUAGE DATABASE
Dynamic Result sets 1
EXTERNAL NAME "CentralCust_Statement" ;