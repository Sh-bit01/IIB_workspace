DECLARE ns1 NAMESPACE 'http://www.example.org/soap_http/';
DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';

CREATE COMPUTE MODULE Soap_Http_Data_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
				
		SET OutputRoot = InputRoot;
		SET OutputRoot.XMLNSC.soapenv:Envelope.soapenv:Body = NULL;
		SET OutputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns1:NewOperationResponse.out = InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns1:NewOperation.in;
		
		
		
	END;
END MODULE;

