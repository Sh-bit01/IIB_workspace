/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		--CALL CopyMessageHeaders();
		 CALL CopyEntireMessage();
		
		--SET OutputRoot.JSON.Data.EmployeesList.COMPANY[] = (SELECT P.* FROM Database.system.COMPANY AS P);
		--SET resultCode = SQLCODE;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

    CREATE PROCEDURE CopyEntireMessage() BEGIN
        
        DECLARE Id INTEGER InputRoot.XMLNSC.Customer.id;
        DECLARE Name CHARACTER InputRoot.XMLNSC.Customer.name;
        DECLARE Country CHARACTER InputRoot.XMLNSC.Customer.country;
        DECLARE Age INTEGER InputRoot.XMLNSC.Customer.age;
		DECLARE resultCode INTEGER;
		
 	

        INSERT INTO Database.System.TIGER_JINDA_HAI
        VALUES (Id, Name, Country, Age);
        SET resultCode = SQLCODE;
        
        
        SET OutputRoot.XMLNSC = resultCode;
        
        
	END;
