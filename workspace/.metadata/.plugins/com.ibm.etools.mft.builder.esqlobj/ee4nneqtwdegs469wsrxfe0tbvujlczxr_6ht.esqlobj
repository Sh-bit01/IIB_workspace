CREATE COMPUTE MODULE db_conn_mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		--CALL CopyMessageHeaders();
		 CALL CopyEntireMessage();
		
		--SET OutputRoot.JSON.Data.EmployeesList.COMPANY[] = (SELECT P.* FROM Database.system.COMPANY AS P);
		--SET resultCode = SQLCODE;
		
		 SET sqlStatement = 'CREATE TABLE eidiko (
                                id INTEGER PRIMARY KEY,
                                name VARCHAR(100),
                                salary DECIMAL(10, 2),
                                age number
                            )';

        -- Execute the SQL statement
        PASSTHRU(sqlStatement);
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

    CREATE PROCEDURE CopyEntireMessage() BEGIN
        
        
        SET OutputRoot = InputRoot;
        
        
	END;
END MODULE;