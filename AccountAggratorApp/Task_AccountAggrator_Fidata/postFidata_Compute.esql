
DECLARE logger EXTERNAL CHARACTER;

DECLARE schema_name EXTERNAL CHARACTER;
DECLARE table_name EXTERNAL CHARACTER;
DECLARE config EXTERNAL CHARACTER;
DECLARE var1 BOOLEAN;
DECLARE dsn EXTERNAL CHARACTER;

CREATE COMPUTE MODULE postFidata_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL initLog4j(config)INTO var1;
		DECLARE method_type CHARACTER;
		SET method_type = SUBSTRING(InputRoot.HTTPInputHeader."X-Original-HTTP-Command" FROM 1 FOR 4);
		IF method_type = 'POST' THEN
			CALL CopyEntireMessage();
		ELSE
			THROW USER EXCEPTION CATALOG 'BIPmsgs' MESSAGE 2230 VALUES('Unsupported HTTP Method');
			PROPAGATE TO TERMINAL 'Catch';
		END IF;
		RETURN TRUE;
	END;


	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE inref REFERENCE TO InputRoot.JSON.Data;
		-- {
		-- "bankId": "101",
		-- "accNo": "00000012345678907",
		-- "dataTypes": [
		-- "PROFILE",
		-- "SUMMARY",
		-- "TRANSACTIONS"
		-- ],
		-- "fromDate": "2020-07-20T10:17:39.171Z",
		-- "toDate": "2023-07-20T10:17:39.171Z"
		-- }
		----------------------------------------------------------------------------------------------------------------
		DECLARE ccsid INTEGER InputRoot.Properties.CodedCharSetId;
		DECLARE enc INTEGER InputRoot.Properties.Encoding;
		DECLARE in_data CHARACTER;
		SET in_data = CAST(ASBITSTREAM(InputRoot.JSON.Data CCSID ccsid ENCODING enc) as CHARACTER CCSID ccsid ENCODING enc);
		CALL WriteLogFile('channel request:'||NodeLabel||' '||NodeType,'fidata','INFO', ' ---------------------------Start---------------------------') INTO var1;
		CALL WriteLogFile('channel request:'||NodeLabel||' '||NodeType,'fidata','INFO', in_data) INTO var1;
		----------------------------------------------------------------------------------------------------------------

		DECLARE query_id CHARACTER 'select * from '||schema_name||'.'||table_name||' where BANK_ID=?';
		-- DECLARE query_join CHARACTER 'SELECT
		-- -- From ACCOUNT_DISCOVERY
		-- ad.BANK_ID,
		-- ad.MOBILE_NO AS DISCOVERY_MOBILE,
		-- ad.EMAIL AS DISCOVERY_EMAIL,
		-- ad.ACCOUNT_NUMBER,
		-- ad.ACC_HOLDER_NAME,
		-- ad.ACC_TYPE AS DISCOVERY_ACC_TYPE,
		-- ad.FI_TYPE,
		-- -- From ACCOUNT_PROFILE
		-- ap.HOLDER_TYPE,
		-- ap.HOLDER_NAME,
		-- ap.DOB,
		-- ap.MOBILE AS PROFILE_MOBILE,
		-- ap.NOMINEE_STATUS,
		-- ap.EMAIL AS PROFILE_EMAIL,
		-- ap.PAN,
		-- ap.CKYC_COMPLIANCE,
		-- -- From ACCOUNT_SUMMARY
		-- asum.CURRENT_BALANCE,
		-- asum.CURRENCY,
		-- asum.EXCHANGE_RATE,
		-- asum.BALANCE_DATETIME,
		-- asum.ACC_TYPE AS SUMMARY_ACC_TYPE,
		-- asum.BRANCH,
		-- asum.FACILITY,
		-- asum.IFSC_CODE,
		-- asum.MICR_CODE,
		-- asum.OPENING_DATE,
		-- asum.OD_LIMIT,
		-- asum.DRAWING_LIMIT,
		-- asum.STATUS,
		-- asum.PENDING_AMOUNT,
		-- -- From ACCOUNT_TRANSACTIONS
		-- at.TXN_ID,
		-- at.TXN_TYPE,
		-- at.TXN_MODE,
		-- at.AMOUNT,
		-- at.CURRENT_BALANCE AS TXN_CURRENT_BALANCE,
		-- at.TRANSACTION_TIMESTAMP,
		-- at.VALUE_DATE,
		-- at.NARRATION,
		-- at.REFERENCE_ID,
		-- at.START_DATE,
		-- at.END_DATE
		--
		-- FROM
		-- '||schema_name||'.'||'ACCOUNT_DISCOVERY ad
		-- LEFT JOIN
		-- '||schema_name||'.'||'ACCOUNT_PROFILE ap ON ad.ACCOUNT_NUMBER = ap.ACCOUNT_NUMBER
		-- LEFT JOIN
		-- '||schema_name||'.'||'ACCOUNT_SUMMARY asum ON ad.ACCOUNT_NUMBER = asum.ACCOUNT_NUMBER
		-- LEFT JOIN
		-- '||schema_name||'.'||'ACCOUNT_TRANSACTIONS at ON ad.ACCOUNT_NUMBER = at.ACCOUNT_NUMBER
		--
		-- WHERE
		-- ad.ACCOUNT_NUMBER = ?
		-- AND at.TRANSACTION_TIMESTAMP BETWEEN
		-- TO_TIMESTAMP_TZ(?, ''YYYY-MM-DD"T"HH24:MI:SS.FF3"Z"'') AND
		-- TO_TIMESTAMP_TZ(?, ''YYYY-MM-DD"T"HH24:MI:SS.FF3"Z"'')
		-- ';


		SET Environment.bank[] = PASSTHRU(query_id TO Database.{dsn} VALUES(inref.bankId));

		IF EXISTS(Environment.bank[]) THEN


			DECLARE query_join CHARACTER 'WITH ONE_HOLDER AS (
			SELECT * FROM (
			SELECT
			ap.*,
			ROW_NUMBER() OVER (PARTITION BY ap.ACCOUNT_NUMBER ORDER BY ap.HOLDER_TYPE) AS rn
			FROM '||Environment.bank.SCHEMA_NAME||'.'||'ACCOUNT_PROFILE ap
			)
			WHERE rn = 1
			)
			SELECT
			-- ACCOUNT_DISCOVERY
			ad.BANK_ID,
			ad.MOBILE_NO AS DISCOVERY_MOBILE,
			ad.EMAIL AS DISCOVERY_EMAIL,
			ad.ACCOUNT_NUMBER,
			ad.ACC_HOLDER_NAME,
			ad.ACC_TYPE AS DISCOVERY_ACC_TYPE,
			ad.FI_TYPE,
			-- ACCOUNT_PROFILE (only 1 holder)
			oh.HOLDER_TYPE,
			oh.HOLDER_NAME,
			oh.DOB,
			oh.MOBILE AS PROFILE_MOBILE,
			oh.NOMINEE_STATUS,
			oh.EMAIL AS PROFILE_EMAIL,
			oh.PAN,
			oh.CKYC_COMPLIANCE,
			-- ACCOUNT_SUMMARY
			asum.CURRENT_BALANCE,
			asum.CURRENCY,
			asum.EXCHANGE_RATE,
			asum.BALANCE_DATETIME,
			asum.ACC_TYPE AS SUMMARY_ACC_TYPE,
			asum.BRANCH,
			asum.FACILITY,
			asum.IFSC_CODE,
			asum.MICR_CODE,
			asum.OPENING_DATE,
			asum.OD_LIMIT,
			asum.DRAWING_LIMIT,
			asum.STATUS,
			asum.PENDING_AMOUNT,
			-- ACCOUNT_TRANSACTIONS
			at.TXN_ID,
			at.TXN_TYPE,
			at.TXN_MODE,
			at.AMOUNT,
			at.CURRENT_BALANCE AS TXN_CURRENT_BALANCE,
			at.TRANSACTION_TIMESTAMP,
			at.VALUE_DATE,
			at.NARRATION,
			at.REFERENCE_ID,
			at.START_DATE,
			at.END_DATE

			FROM '||Environment.bank.SCHEMA_NAME||'.'||'ACCOUNT_DISCOVERY ad
			LEFT JOIN ONE_HOLDER oh ON ad.ACCOUNT_NUMBER = oh.ACCOUNT_NUMBER
			LEFT JOIN '||Environment.bank.SCHEMA_NAME||'.'||'ACCOUNT_SUMMARY asum ON ad.ACCOUNT_NUMBER = asum.ACCOUNT_NUMBER
			LEFT JOIN '||Environment.bank.SCHEMA_NAME||'.'||'ACCOUNT_TRANSACTIONS at ON ad.ACCOUNT_NUMBER = at.ACCOUNT_NUMBER

			WHERE ad.ACCOUNT_NUMBER = ?
			AND at.TRANSACTION_TIMESTAMP BETWEEN
			TO_TIMESTAMP_TZ(?, ''YYYY-MM-DD"T"HH24:MI:SS.FF3"Z"'') AND
			TO_TIMESTAMP_TZ(?, ''YYYY-MM-DD"T"HH24:MI:SS.FF3"Z"'')
			ORDER BY at.TRANSACTION_TIMESTAMP DESC;
			';
			--SET Environment.bank[] = PASSTHRU(query_id TO Database.{dsn} VALUES(inref.bankId));
			SET Environment.Summary[] = PASSTHRU(query_join TO Database.{Environment.bank.DSN_NAME} VALUES(inref.accNo,inref.fromDate, inref.toDate));


			IF EXISTS(Environment.Summary[]) THEN

				CREATE FIELD OutputRoot.JSON.Data;
				DECLARE jsonRef REFERENCE TO OutputRoot.JSON.Data;
				SET jsonRef.status = 'success';
				SET jsonRef.BankCode = Environment.bank.BANK_CODE;
				SET jsonRef.BankName = Environment.bank.BANK_NAME;

				CREATE FIELD OutputRoot.JSON.Data.data.Account;
				DECLARE accRef REFERENCE TO OutputRoot.JSON.Data.data.Account;
				declare txnref REFERENCE to Environment.Summary[1];

				SET accRef.type = 'deposit';
				--SET accRef.Profile.Holders.type = txnref.HOLDER_TYPE;

				CREATE FIELD accRef.Profile.Holders type JSON.Array;
				DECLARE holref REFERENCE TO txnref;

				declare j INTEGER 1;
				--while LASTMOVE(holref) do
				SET accRef.Profile.Holders.Item[j].type = holref.HOLDER_TYPE;
				SET accRef.Profile.Holders.Item[j].Holder.name = holref.HOLDER_NAME;
				SET accRef.Profile.Holders.Item[j].Holder.dob = holref.DOB;
				SET accRef.Profile.Holders.Item[j].Holder.mobile = holref.PROFILE_MOBILE;
				SET accRef.Profile.Holders.Item[j].Holder.nominee = holref.NOMINEE_STATUS;
				SET accRef.Profile.Holders.Item[j].Holder.email = holref.PROFILE_EMAIL ;
				SET accRef.Profile.Holders.Item[j].Holder.pan = holref.PAN;
				SET accRef.Profile.Holders.Item[j].Holder.ckycCompliance = holref.CKYC_COMPLIANCE ;
				SET j = j+1;
				--MOVE holref NEXTSIBLING;
				--end WHILE;


				SET accRef.Summary.currentBalance = txnref.CURRENT_BALANCE;
				SET accRef.Summary.currency = txnref.CURRENCY;
				SET accRef.Summary.exchgeRate = txnref.EXCHANGE_RATE;
				SET accRef.Summary.balanceDateTime = txnref.BALANCE_DATETIME;
				SET accRef.Summary.type = txnref.SUMMARY_ACC_TYPE;
				SET accRef.Summary.branch = txnref.BRANCH;
				SET accRef.Summary.facility = txnref.FACILITY;
				SET accRef.Summary.ifscCode = txnref.IFSC_CODE;
				SET accRef.Summary.micrCode = txnref.MICR_CODE;
				SET accRef.Summary.openingDate = txnref.OPENING_DATE;
				SET accRef.Summary.currentODLimit = txnref.OD_LIMIT;
				SET accRef.Summary.drawingLimit = txnref.DRAWING_LIMIT;
				SET accRef.Summary.status = txnref.STATUS;
				SET accRef.Summary.Pending.amount = CAST(txnref.PENDING_AMOUNT AS INTEGER);

				SET accRef.Transactions.startDate = inref.fromDate;
				SET accRef.Transactions.endDate = inref.toDate;

				CREATE FIELD accRef.Transactions.Transaction type JSON.Array;


				declare i INTEGER 1;
				while LASTMOVE(txnref) do
					SET accRef.Transactions.Transaction.Item[i].txnId = txnref.TXN_ID;
					SET accRef.Transactions.Transaction.Item[i].type = txnref.TXN_TYPE;
					SET accRef.Transactions.Transaction.Item[i].mode = txnref.TXN_MODE;
					SET accRef.Transactions.Transaction.Item[i].amount = CAST(txnref.AMOUNT AS INTEGER);
					SET accRef.Transactions.Transaction.Item[i].currentBalance = CAST(txnref.TXN_CURRENT_BALANCE AS INTEGER);
					SET accRef.Transactions.Transaction.Item[i].transactionTimestamp = txnref.TRANSACTION_TIMESTAMP;
					SET accRef.Transactions.Transaction.Item[i].valueDate = txnref.VALUE_DATE;
					SET accRef.Transactions.Transaction.Item[i].narration = txnref.NARRATION;
					SET accRef.Transactions.Transaction.Item[i].reference = txnref.REFERENCE_ID;
					set i = i+1;
					move txnref NEXTSIBLING;
				end WHILE;

			ELSE
				SET OutputRoot.JSON.Data.status = 'error';
				SET OutputRoot.JSON.Data.message = 'Invalid Account no ';
			END IF;

		ELSE
			SET OutputRoot.JSON.Data.status = 'error';
			SET OutputRoot.JSON.Data.message = 'Invalid Bank ID ';
		END IF;
		----------------------------------------------------------------------------------------------------------------
		DECLARE data CHARACTER;
		SET data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID ccsid ENCODING enc) as CHARACTER CCSID ccsid ENCODING enc);
		CALL WriteLogFile('channel responce:'||NodeLabel||' '||NodeType,'fidata','INFO', data) INTO var1;
		CALL WriteLogFile('channel responce:'||NodeLabel||' '||NodeType,'fidata','INFO', ' ---------------------------END---------------------------') INTO var1;
		----------------------------------------------------------------------------------------------------------------

	END;
END MODULE;


CREATE FUNCTION WriteLogFile( IN COMPONENT_NAME CHARACTER,IN LOGGER_NAME CHARACTER, IN LEVEL CHARACTER, IN TEXT CHARACTER )
RETURNS BOOLEAN
LANGUAGE JAVA --Indicates that this function is implemented in Java.
EXTERNAL NAME "com.ibm.broker.IAM3.Log4jNode.log"; --Specifies the fully qualified Java class and method used for logging.
-- Define a Java function named initLog4j for initializing Log4j with the provided configuration file.
CREATE FUNCTION initLog4j( IN CONFIG_FILE_NAME CHARACTER )
RETURNS BOOLEAN
LANGUAGE JAVA
EXTERNAL NAME "com.ibm.broker.IAM3.Log4jNode.initLog4j"; -- Specifies the fully qualified Java class and method used for initialization.