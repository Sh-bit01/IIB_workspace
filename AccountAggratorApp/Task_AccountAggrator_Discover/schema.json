{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "bank_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{3}$"
    },
    "mobileNo": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    }
  },
  "required": [
    "bank_id",
    "mobileNo"
  ]
}
