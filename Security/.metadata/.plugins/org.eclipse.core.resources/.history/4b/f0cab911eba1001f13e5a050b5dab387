<?xml version="1.0" encoding="UTF-8"?><?ibm-bip policySet="Policy_1"?>
<securitybinding:securityBindings xmlns:securitybinding="http://www.ibm.com/xmlns/prod/websphere/200710/ws-securitybinding">
  <securitybinding:securityBinding name="application">
    <securitybinding:securityOutboundBindingConfig>
      <securitybinding:encryptionInfo name="gen_enc" order="0">
        <securitybinding:encryptionPartReference reference="request:enc">
          <securitybinding:dataEncryptionKeyInfo reference="gen_as_token_encenc_keyinfo"/>
          <securitybinding:nonce/>
          <securitybinding:timestamp/>
        </securitybinding:encryptionPartReference>
      </securitybinding:encryptionInfo>
      <securitybinding:keyInfo classname="com.ibm.ws.wssecurity.wssapi.CommonContentGenerator" name="gen_auth_keyinfo" type="STRREF">
        <securitybinding:tokenReference reference="gen_auth"/>
      </securitybinding:keyInfo>
      <securitybinding:keyInfo classname="com.ibm.ws.wssecurity.wssapi.CommonContentGenerator" name="gen_as_token_encenc_keyinfo" type="X509ISSUER">
        <securitybinding:tokenReference reference="gen_as_token"/>
        <securitybinding:derivedKeyInfo keyLength="16">
          <securitybinding:requireDerivedKeys/>
          <securitybinding:requireExplicitDerivedKeys/>
        </securitybinding:derivedKeyInfo>
      </securitybinding:keyInfo>
      <securitybinding:tokenGenerator classname="com.ibm.ws.wssecurity.wssapi.token.impl.CommonTokenGenerator" name="gen_auth">
        <securitybinding:valueType localName="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-x509-token-profile-1.0#X509v3"/>
        <securitybinding:securityTokenReference reference="request:auth"/>
        <securitybinding:jAASConfig configName="system.wss.generate.x509"/>
        <securitybinding:callbackHandler classname="com.ibm.websphere.wssecurity.callbackhandler.X509GenerateCallbackHandler">
          <securitybinding:keyStore path="*MQSIBROKERSTOREPATHMQSI*" storepass="*MQSIBROKERSTOREPWDMQSI*" type="JKS"/>
          <securitybinding:key alias="iibdev" keypass="*MQSIBROKERSTOREKEYPASSiibdevMQSI*" name="CN=192.168.3.43, C=US"/>
        </securitybinding:callbackHandler>
      </securitybinding:tokenGenerator>
      <securitybinding:tokenGenerator classname="com.ibm.ws.wssecurity.wssapi.token.impl.CommonTokenGenerator" name="gen_as_token">
        <securitybinding:valueType localName="http://docs.oasis-open.org/wss/oasis-wss-kerberos-token-profile-1.1#GSS_Kerberosv5_AP_REQ"/>
        <securitybinding:jAASConfig configName="system.wss.generate.KRB5BST"/>
        <securitybinding:callbackHandler classname="com.ibm.websphere.wssecurity.callbackhandler.KRBTokenGenerateCallbackHandler"/>
        <securitybinding:properties name="com.ibm.wsspi.wssecurity.kerberos.attach.apreq" value="true"/>
      </securitybinding:tokenGenerator>
    </securitybinding:securityOutboundBindingConfig>
    <securitybinding:securityInboundBindingConfig/>
  </securitybinding:securityBinding>
</securitybinding:securityBindings>