CREATE COMPUTE MODULE Kafka_node_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot.JSON.Data = InputRoot.JSON.Data.data;
		SET OutputRoot.HTTPInputHeader = InputRoot.JSON.Data.a.HTTPInputHeader;
		--SET OutputLocalEnvironment.Destination = InputRoot.JSON.Data.a.Destination;
		
		DECLARE requestIdentifierBlob BLOB;

		-- Cast RequestIdentifier (CHARACTER) back to BLOB
		SET requestIdentifierBlob = CAST(InputRoot.JSON.Data.a.Destination.HTTP.RequestIdentifier AS BLOB CCSID InputRoot.Properties.CodedCharSetId);
		
		-- Store back the correct BLOB value into LocalEnvironment
		SET OutputLocalEnvironment.Destination.HTTP.RequestIdentifier = requestIdentifierBlob;
		
		SET OutputRoot.HTTPResponseBody = InputRoot.JSON.Data.data;  -- Example for XML message
		

	END;
END MODULE;