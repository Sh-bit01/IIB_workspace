--
--	  SET OutputRoot.MQMD.Format = 'MQSTR';
--      SET OutputRoot.MQRFH2.psc.Topic = 'sss';
      
	--SET OutputRoot.MQRFH2.psc.Topic = 'qwert';
	
	
	END;
END MODULE;