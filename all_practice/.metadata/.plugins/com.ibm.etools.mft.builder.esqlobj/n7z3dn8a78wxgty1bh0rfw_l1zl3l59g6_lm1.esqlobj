CREATE COMPUTE MODULE urL_encod_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		-- SET OutputRoot = InputRoot;

		DECLARE encode REFERENCE TO InputRoot.JSON.Data.root.encode;
		CREATE LASTCHILD OF OutputRoot.JSON.Data NAME Encode VALUE URLENCODE(encode);		
		
--		DECLARE Decode REFERENCE TO InputRoot.JSON.Data.root.Decode;
--		CREATE LASTCHILD OF OutputRoot.JSON.Data.Decode VALUE URLDECODE(Decode);


	END;
END MODULE;