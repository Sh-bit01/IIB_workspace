CREATE COMPUTE MODULE Create_stst_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		
		
		--CREATE LASTCHILD OF OutputRoot NAME 'JSON';
--	CREATE FIRSTCHILD OF OutputRoot.JSON NAME 'Data';
		CREATE FIELD OutputRoot.JSON.Data.name VALUE 'shree';
		
		CREATE NEXTSIBLING OF OutputRoot.JSON.Data.name NAME 'ADDRESS' VALUE 'address';
		--CREATE NEXTSIBLING OF OutputRoot.JSON.Data.ADDRESS TYPE NameValue VALUE 'amt';
		
		
		
		
		
		
		
	END;
END MODULE;