CREATE COMPUTE MODULE f1st_msg_flow
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot.XMLNSC.Res = InputRoot.JSON.Data;
		DECLARE partData BLOB ASBITSTREAM(OutputRoot.XMLNSC CCSID InputRoot.Properties.CodedCharSetId ENCODING InputRoot.Properties.Encoding);

		SET OutputRoot = NULL;
		SET OutputRoot.Properties.ContentType = 'text/xml';
		CREATE FIELD OutputRoot.MIME TYPE Name;
		DECLARE M REFERENCE TO OutputRoot.MIME;
		CREATE LASTCHILD OF M TYPE Name NAME 'Data';
		CREATE FIELD OutputRoot.MIME.Data."Content-Type" TYPE NameValue VALUE 'text/xml';
		CREATE LASTCHILD OF M.Data DOMAIN('BLOB') PARSE(partData);



--		-- Set Content-Type for multipart MIME message
--		SET OutputRoot.Properties.ContentType = 'multipart/related; boundary=myBoundary';
--		-- Create the MIME structure
--		CREATE FIELD OutputRoot.MIME TYPE Name;
