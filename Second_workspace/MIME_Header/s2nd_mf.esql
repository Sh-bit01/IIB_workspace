

CREATE COMPUTE MODULE s2nd_mf
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
--		DECLARE b1 BLOB InputRoot.MIME.Parts.Part[1].Data.BLOB.BLOB;
--		DECLARE b2 BLOB InputRoot.MIME.Parts.Part[2].Data.BLOB.BLOB;
--		DECLARE P1 REFERENCE TO Environment;
--		CREATE LASTCHILD OF P1 DOMAIN('JSON') PARSE(b2);
--		CREATE LASTCHILD OF P1 DOMAIN('XMLNSC') PARSE(b1);
		
		
	END;
END MODULE;  
