

CREATE COMPUTE MODULE lds_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE i,o,io INTEGER;
		SET i = 5;
		SET OutputRoot.JSON.Data.in = InputRoot;
		SET OutputRoot.JSON.Data.in = InputRoot;
		SET OutputRoot.JSON.Data.in = InputRoot;
	END;
END MODULE;

CREATE FUNCTION  k (IN k INTEGER, OUT b INTEGER, INOUT r INTEGER ) RETURNS INTEGER
BEGIN
--DECLARE b,r,k INTEGER;
SET r = k; 
SET b = k; 
	RETURN b;
END;
