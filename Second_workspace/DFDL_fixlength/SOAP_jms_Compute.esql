

CREATE COMPUTE MODULE SOAP_jms_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot.DFDL.csv_Data.record.name = InputRoot.DFDL.fixlength_data.body.name;
		SET OutputRoot.DFDL.csv_Data.record.age =  InputRoot.DFDL.fixlength_data.body.age;
		SET OutputRoot.DFDL.csv_Data.record.place =  InputRoot.DFDL.fixlength_data.body.place;
		
		
		
		
		
		---
		--SET OutputRoot.XMLNSC.Data = OutputRoot.DFDL.csv_Data;
	END;
END MODULE;
