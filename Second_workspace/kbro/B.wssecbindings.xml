<?xml version="1.0" encoding="UTF-8"?><?ibm-bip policySet="P"?>
<securitybinding:securityBindings xmlns:securitybinding="http://www.ibm.com/xmlns/prod/websphere/200710/ws-securitybinding">
  <securitybinding:securityBinding name="application">
    <securitybinding:securityOutboundBindingConfig>
      <securitybinding:encryptionInfo name="gen_data" order="1">
        <securitybinding:encryptionPartReference reference="request:data">
          <securitybinding:dataEncryptionKeyInfo reference="gen_Stoken_encdata_keyinfo"/>
          <securitybinding:nonce/>
          <securitybinding:timestamp/>
        </securitybinding:encryptionPartReference>
      </securitybinding:encryptionInfo>
      <securitybinding:keyInfo classname="com.ibm.ws.wssecurity.wssapi.CommonContentGenerator" name="gen_Stoken_encdata_keyinfo" type="STRREF">
        <securitybinding:tokenReference reference="gen_Stoken"/>
      </securitybinding:keyInfo>
      <securitybinding:tokenGenerator classname="com.ibm.ws.wssecurity.wssapi.token.impl.CommonTokenGenerator" name="gen_Stoken">
        <securitybinding:valueType localName="http://docs.oasis-open.org/wss/oasis-wss-kerberos-token-profile-1.1#GSS_Kerberosv5_AP_REQ"/>
        <securitybinding:jAASConfig configName="system.wss.generate.KRB5BST"/>
        <securitybinding:callbackHandler classname="com.ibm.websphere.wssecurity.callbackhandler.KRBTokenGenerateCallbackHandler"/>
        <securitybinding:properties name="com.ibm.wsspi.wssecurity.kerberos.attach.apreq" value="true"/>
      </securitybinding:tokenGenerator>
    </securitybinding:securityOutboundBindingConfig>
    <securitybinding:securityInboundBindingConfig/>
  </securitybinding:securityBinding>
</securitybinding:securityBindings>