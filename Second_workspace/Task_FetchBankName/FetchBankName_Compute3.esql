

CREATE COMPUTE MODULE FetchBankName_Compute3
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		DECLARE messageNumber INTEGER;
		DECLARE messageText CHAR;
		DECLARE messageInsert ROW;
		DECLARE ExpTitle CHARACTER;

		DECLARE text CHARACTER 'Text';
		DECLARE inst CHARACTER 'Insert';
		DECLARE i INTEGER;
		DECLARE ptrException REFERENCE TO InputExceptionList.*[1];
		WHILE LASTMOVE(ptrException) DO
			--IF FIELDNAME(ptrException) <> text AND FIELDNAME (ptrException) <> inst THEN

			IF FIELDNAME(ptrException) NOT IN(text, inst) THEN
				SET ExpTitle = FIELDNAME(ptrException);
			END IF;
			-- Store the current values for the error number and text
			IF ptrException.Number is not null THEN
				SET messageNumber = ptrException.Number;
				SET messageText = ptrException.Text;
				IF ptrException.Insert.Text IS NOT NULL THEN
					DECLARE insRef REFERENCE TO ptrException.Insert[1];
					SET i = 1;
					SET messageInsert = NULL;
					WHILE LASTMOVE(insRef) DO
						SET messageInsert.Text[i] = insRef.Text;
						set i = i+1;
						MOVE insRef NEXTSIBLING;
					END WHILE;
				END IF;
			END IF;

			MOVE ptrException LASTCHILD;
		END WHILE;
		--CALL getLastExceptionDetail(InputExceptionList, messageNumber, messageText, messageInsert);
		SET OutputRoot.XMLNSC.{ExpTitle}.excpType = ExpTitle;
		SET OutputRoot.XMLNSC.{ExpTitle}.messageNumber = messageNumber;
		SET OutputRoot.XMLNSC.{ExpTitle}.actualExcpText = messageText;

		DECLARE ExpText REFERENCE TO messageInsert.Text[1];
		WHILE LASTMOVE(ExpText) DO
			IF LENGTH(ExpText) > 6 THEN
				SET OutputRoot.XMLNSC.{ExpTitle}.excpText = ExpText;
			END IF;

			MOVE ExpText NEXTSIBLING;
		END WHILE;

		--SET OutputRoot.XMLNSC.{ExpTitle}.excpText = CAST(messageInsert.Text AS CHARACTER CCSID InputRoot.Properties.CodedCharSetId ENCODING InputRoot.Properties.Encoding);

		DECLARE cssid REFERENCE TO InputRoot.Properties.CodedCharSetId;
		DECLARE Encoding REFERENCE TO InputRoot.Properties.Encoding;
	END;
END MODULE;
