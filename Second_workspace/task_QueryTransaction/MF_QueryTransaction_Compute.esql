DECLARE ns NAMESPACE 'http://fcubs.ofss.com/service/FCUBSRTService';


CREATE COMPUTE MODULE MF_QueryTransaction_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
	CREATE LASTCHILD OF OutputRoot DOMAIN('SOAP');
	DECLARE inref REFERENCE TO InputRoot.JSON.Data;     --add the refrence on input 

	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.SOURCE= 'GIP';               --add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.UBSCOMP= 'FCUBS' ; 			--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.MSGID= 'YW3152455211';		--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.CORRELID= 'YW3152455211';	--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.USERID= 'GIPUSER' ;			--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.BRANCH= '083';				--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.MODULEID= 'RT';				--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.SERVICE= 'FCUBSRTService';	--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.OPERATION= 'QueryTransaction';		--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.SOURCE_OPERATION= 'QueryTransaction';		--add value
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.SOURCE_USERID= 'GIPUSER' ;			--add value
	
	-- Optional: with Zero or more repetitions
	DECLARE opt REFERENCE TO inref.PARAM[1];   -- add the ref 
	DECLARE i INTEGER 1;
	WHILE LASTMOVE(opt) DO
		SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.ADDL.PARAM[i].NAME= opt.NAME;    	 --add value 
		SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_HEADER.ADDL.PARAM[i].VALUE= opt.VALUE;		 --add value 
		SET i = i+1;
		MOVE opt NEXTSIBLING;
	END WHILE;
	SET OutputRoot.SOAP.Body.ns:QUERYTRANSACTION_IOFS_REQ.FCUBS_BODY."Transaction-Details-IO".XREF= inref.SessionID;
	END;
END MODULE;
