CREATE COMPUTE MODULE postDiscover_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		-- {"mobileNo":"8501996633",
		-- "bank_id":101,
		-- "fitype":"DEPOSIT"}


		DECLARE inref REFERENCE TO InputRoot.JSON.Data;
		DECLARE query_id CHARACTER 'select * from BANKS_DETAIL where BANK_ID=?';
		DECLARE query_AccDis CHARACTER;
		DECLARE retryCount INTEGER 0;
		--WHILE retryCount <= 2 DO
		-- DECLARE EXIT HANDLER FOR SQLSTATE LIKE '%'
		-- BEGIN
		-- SET retryCount = retryCount + 1;
		-- END;
		SET Environment.bank[] = PASSTHRU(query_id VALUES(inref.bank_id));
		SET query_AccDis = 'select * from '||Environment.bank.SCHEMA_NAME||'.'||Environment.bank.TABLE_NAME||' where BANK_ID=? and MOBILE_NO=?';
		SET Environment.AccDis[] = PASSTHRU(query_AccDis TO Database.{Environment.bank.DSN_NAME} VALUES(Environment.bank.BANK_ID, inref.mobileNo));
		-- END WHILE;

		SET OutputRoot.JSON.Data.status = 'success';
		SET OutputRoot.JSON.Data.BankCode = Environment.bank.BANK_CODE;
		SET OutputRoot.JSON.Data.BankName = Environment.bank.BANK_NAME;
		CREATE FIELD OutputRoot.JSON.Data.accounts type JSON.Array;
		declare i INTEGER 1;
		declare bankref REFERENCE to Environment.AccDis[1];
		while LASTMOVE(bankref) do
			set OutputRoot.JSON.Data.accounts.Item[i].accountNumber=bankref.ACCOUNT_NUMBER;
			set OutputRoot.JSON.Data.accounts.Item[i].accountType=bankref.ACC_TYPE;
			set OutputRoot.JSON.Data.accounts.Item[i].fitype=bankref.FI_TYPE;
			set i = i+1;
			move bankref NEXTSIBLING;
		end WHILE;
		


		--SET OutputRoot.JSON.Data.res[] = Environment.AccDis[];



	END;
END MODULE;