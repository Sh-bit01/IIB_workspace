        <body xmi:type="utility:ConstantString" string="data is sended by this node with the XML header incluuded &#xA;&quot;&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&quot;&#xA;like this &#xA;there is no direct way to remove it we have to use the Compute node to convert ti into the JSON"/>
