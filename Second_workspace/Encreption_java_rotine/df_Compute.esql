





CREATE COMPUTE MODULE df_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;

		DECLARE data CHARACTER;
		DECLARE data1 CHARACTER;

		call enc('client', 'hii my name is shreyash') INTO data;
		SET OutputRoot.JSON.Data.client.Encryption = data;


		call enc('client1', 'hii my name is shreyash') INTO data1;
		SET OutputRoot.JSON.Data.client1.Encryption = data1;

	END;
END MODULE;

CREATE PROCEDURE enc (in alias CHARACTER, in data CHARACTER )
RETURNS CHARACTER
LANGUAGE JAVA
EXTERNAL NAME "encdec.Security.encryptPassword";

CREATE PROCEDURE dec (in data CHARACTER )
RETURNS CHARACTER
LANGUAGE JAVA
EXTERNAL NAME "encdec.Security.decryptPassword";

