CREATE COMPUTE MODULE mini_mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot.EmailOutputHeader.To = 'gabriel@test.com';
		SET OutputRoot.EmailOutputHeader.From = 'shreyash@test.com';
		SET OutputRoot.EmailOutputHeader.Subject = InputRoot.JSON.Data.mail.subject;
		SET OutputLocalEnvironment.Destination.Email.SMTPServer ='192.168.2.21:25';
		SET OutputRoot.BLOB.BLOB = CAST(InputRoot.JSON.Data.mail.body AS BLOB CCSID 1208);
	END;
END MODULE;












