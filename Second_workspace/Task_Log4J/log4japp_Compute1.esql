



CREATE COMPUTE MODULE log4japp_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL initLog4j(external_var)INTO var1;

		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE ccsid INTEGER InputRoot.Properties.CodedCharSetId;
		DECLARE enc INTEGER InputRoot.Properties.Encoding;
		SET OutputRoot = InputRoot;
		DECLARE ref REFERENCE TO InputExceptionList.*[>];
		DECLARE Text CHARACTER;
		DECLARE Itm ROW;

		WHILE LASTMOVE(ref) DO
			MOVE ref LASTCHILD;
			IF ref.Number IS NOT NULL THEN
				SET Text = ref.Text;
				SET Itm.item[] = ref.Insert[];
			END IF;
		END WHILE;

		DECLARE v INTEGER CARDINALITY(Itm.item[]);
		--SET OutputRoot.JSON.Data.error.message = Itm.item[v-3].Text;
		--SET OutputRoot.JSON.Data.error.statusCode = Itm.item[v-2].Text;
		SET OutputRoot.JSON.Data.error.error_desc = Text;

		SET OutputRoot.JSON.Data.error.messagId = 563214785965219762;
		--SET OutputRoot.JSON.Data.error.additionalData.Error.esb_error_code = Itm.item[v-1].Text;

		DECLARE refI REFERENCE TO Itm.item[1];
		DECLARE text CHARACTER '';
		WHILE LASTMOVE(refI) DO
			SET text = text ||'  ' ||refI.Text;
			MOVE refI NEXTSIBLING;
		END WHILE;
		SET OutputRoot.JSON.Data.error.additionalData.Error.esb_error_desc = text;

		DECLARE data CHARACTER;
		SET data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID ccsid ENCODING enc) as CHARACTER CCSID ccsid ENCODING enc);
		DECLARE exp REFERENCE TO InputExceptionList.[1];
		CALL WriteLogFile(exp.Label ||' '||exp.Type,'Logger2','ERROR', data) INTO var1;

	END;
END MODULE;