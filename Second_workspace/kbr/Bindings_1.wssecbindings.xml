<?xml version="1.0" encoding="UTF-8"?><?ibm-bip policySet="Policy_1"?>
<securitybinding:securityBindings xmlns:securitybinding="http://www.ibm.com/xmlns/prod/websphere/200710/ws-securitybinding">
  <securitybinding:securityBinding name="application">
    <securitybinding:securityOutboundBindingConfig>
      <securitybinding:signingInfo name="gen_sdvfv" order="1">
        <securitybinding:signingKeyInfo reference="gen_kaka_signsdvfv_keyinfo"/>
        <securitybinding:signingPartReference reference="request:sdvfv">
          <securitybinding:transform algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
        </securitybinding:signingPartReference>
      </securitybinding:signingInfo>
      <securitybinding:keyInfo classname="com.ibm.ws.wssecurity.wssapi.CommonContentGenerator" name="gen_kaka_signsdvfv_keyinfo" type="STRREF">
        <securitybinding:tokenReference reference="gen_kaka"/>
        <securitybinding:derivedKeyInfo keyLength="16">
          <securitybinding:requireDerivedKeys/>
          <securitybinding:requireExplicitDerivedKeys/>
        </securitybinding:derivedKeyInfo>
      </securitybinding:keyInfo>
      <securitybinding:tokenGenerator classname="com.ibm.ws.wssecurity.wssapi.token.impl.CommonTokenGenerator" name="gen_kaka">
        <securitybinding:valueType localName="http://docs.oasis-open.org/wss/oasis-wss-kerberos-token-profile-1.1#GSS_Kerberosv5_AP_REQ"/>
        <securitybinding:jAASConfig configName="system.wss.generate.KRB5BST"/>
        <securitybinding:callbackHandler classname="com.ibm.websphere.wssecurity.callbackhandler.KRBTokenGenerateCallbackHandler"/>
        <securitybinding:properties name="com.ibm.wsspi.wssecurity.krbtoken.targetServiceName" value="HTTP"/>
        <securitybinding:properties name="com.ibm.wsspi.wssecurity.krbtoken.targetServiceRealm" value="EXAMPLE.COM"/>
        <securitybinding:properties name="com.ibm.wsspi.wssecurity.krbtoken.targetServiceHost" value="192.168.2.21"/>
        <securitybinding:properties name="com.ibm.wsspi.wssecurity.kerberos.attach.apreq" value="true"/>
      </securitybinding:tokenGenerator>
    </securitybinding:securityOutboundBindingConfig>
    <securitybinding:securityInboundBindingConfig/>
  </securitybinding:securityBinding>
</securitybinding:securityBindings>