

CREATE COMPUTE MODULE MF_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot.JSON.Data.status = 'success';
		--SET OutputLocalEnvironment.TCPIP.Input.ConnectionDetails.Hostname = InputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Hostname;
		
		
		DECLARE returnValue BOOLEAN;
		SET returnValue = SLEEP(10000);
	END;
END MODULE;
