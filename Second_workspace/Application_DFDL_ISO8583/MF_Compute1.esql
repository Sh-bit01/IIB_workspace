

CREATE COMPUTE MODULE MF_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
		SET OutputLocalEnvironment = InputLocalEnvironment;
		SET OutputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Hostname = InputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Hostname;
		
		SET OutputLocalEnvironment.WrittenDestination.TCPIP.Output.ConnectionDetails.Hostname = InputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Hostname;
		SET OutputLocalEnvironment.WrittenDestination.TCPIP.Output.ConnectionDetails.Address = InputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Address;
		SET OutputLocalEnvironment.Destination.TCPIP.Output.Hostname = InputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Hostname;
		SET OutputLocalEnvironment.Destination.TCPIP.Output.Address = InputLocalEnvironment.TCPIP.Input.ConnectionDetails.ClientDetails.Address;
		--propagate to terminal 'out';
		--propagate to terminal 'out1';
		
	END;
END MODULE;
