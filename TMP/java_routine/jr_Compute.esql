

CREATE COMPUTE MODULE jr_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE a CHARACTER;
		CALL data('5fdg','8') INTO a;
		SET OutputRoot.JSON.Data.string = a;
		SET OutputRoot.JSON.Data.sum = sum('5','8');
		
	END;
END MODULE;

CREATE PROCEDURE data (in a CHARACTER, in b CHARACTER ) RETURNS CHARACTER
LANGUAGE JAVA
EXTERNAL NAME "addopr.Math.name" ;


CREATE PROCEDURE sum (in a CHARACTER, in b CHARACTER ) RETURNS CHARACTER
LANGUAGE JAVA
EXTERNAL NAME "addopr.Math.add" ;


