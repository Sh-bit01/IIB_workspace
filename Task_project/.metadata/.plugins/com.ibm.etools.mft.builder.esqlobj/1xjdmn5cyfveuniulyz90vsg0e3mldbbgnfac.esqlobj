/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
		DECLARE CID INTEGER InputRoot.Properties.CodedCharSetId;
		DECLARE Encod INTEGER InputRoot.Properties.Encoding;
		DECLARE in_data, out_data, o CHARACTER;

		SET in_data = CAST(ASBITSTREAM(InputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);

		---SET ser_Url = '-';
		DECLARE myBlob1 BLOB ASBITSTREAM(InputBody CCSID InputRoot.Properties.CodedCharSetId Encoding InputRoot.Properties.Encoding );
		DECLARE msg CHARACTER CAST(myBlob1 AS CHAR CCSID InputRoot.Properties.CodedCharSetId Encoding InputRoot.Properties.Encoding);

		DECLARE appName CHARACTER ApplicationLabel;
		DECLARE msgName CHARACTER MessageFlowLabel;
		DECLARE LogType CHARACTER 'Host responce';
		CALL InsertLogs (appName, msgName, LogType, Environment.Ser_id, Environment.ser_Url, msg);		
		

		SET out_data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);

		CALL WriteLogFile(MessageFlowLabel, 'Logger2', 'INFO','Responce_Data: ' || in_data) INTO var1;
		CALL WriteLogFile(MessageFlowLabel, 'Logger2', 'INFO', 'Responce_Output_Data: ' || out_data) INTO var1;
		CALL WriteLogFile(MessageFlowLabel, 'Logger2', 'INFO', '    ' || o) INTO var1;
		
		----------Channel Responce
		SET myBlob1 = ASBITSTREAM(OutputRoot CCSID InputRoot.Properties.CodedCharSetId Encoding InputRoot.Properties.Encoding );
		SET msg = CAST(myBlob1 AS CHAR CCSID InputRoot.Properties.CodedCharSetId Encoding InputRoot.Properties.Encoding);

		SET appName = ApplicationLabel;
		SET msgName = MessageFlowLabel;
		SET LogType = 'Channel Responce';
		CALL InsertLogs (appName, msgName, LogType, Environment.Ser_id, Environment.ser_Url, msg);

	END;
