/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE cardId CHARACTER;
		DECLARE r ROW;
		DECLARE query CHARACTER;

		SET cardId = InputLocalEnvironment.HTTP.Input.QueryString.cardId;

		IF LENGTH(cardId)=16 THEN
			SET query = 'select * from CARD_DETAILS Where CARD_ID=?';
			set r.res[] = PASSTHRU(query, cardId);
		ELSE
			THROW USER EXCEPTION VALUES('Failure','ESB-APPC-998', '2951', 'com.sbm.eidiko.HTTPGatewayReq_FramingAPICallReq.Main,CARD_ID length is not equal to 16. Please pass the valid lengthMessage Id length is not equal to 16. Please pass the valid length');	
		END IF;
		


		IF r.res.CARD_ID IS NOT NULL THEN
			SET OutputRoot.JSON.Data.status_code = '200';
			SET OutputRoot.JSON.Data.data[] = r.res[];

		ELSE
			THROW USER EXCEPTION VALUES('Failure','ESB-APPC-401', '5841', 'com.sbm.eidiko.HTTPGatewayReq_FramingAPICallReq.Main, Account Not Found - The provided CARD_ID is not valid or does not exist in the database.');	
		END IF;


	END;
