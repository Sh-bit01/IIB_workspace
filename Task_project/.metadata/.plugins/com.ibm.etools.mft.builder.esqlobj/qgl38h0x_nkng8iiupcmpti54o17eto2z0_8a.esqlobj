CREATE COMPUTE MODULE Router_Flow_Mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;


		DECLARE Service_Url CHARACTER;
		DECLARE Service_Code INTEGER;

		SET Service_Code = InputRoot.HTTPInputHeader.Service_code; ----Service_Code in http Header		
		


		DECLARE r ROW;
		set r.res[] = PASSTHRU('select SERVICE_URL from SERVICES_TABLE where SERVICE_CODE=?', Service_Code);

		SET Service_Url = PASSTHRU('select SERVICE_URL from SERVICES_TABLE where SERVICE_CODE=?', Service_Code);

		IF ResultRow IS NOT NULL THEN
			SET Service_Url = ResultRow.SERVICE_URL; -- Assuming the structure is correctly defined
		ELSE
			-- Handle the case where no rows were returned (if necessary)
			SET Service_Url = 'Not Found'; -- or handle this case as needed
		END IF;		


		SET OutputRoot = InputRoot;		
		
		
		




	END;
END MODULE;