









path Logging;

DECLARE external_var EXTERNAL CHARACTER;
DECLARE var1 BOOLEAN;


CREATE COMPUTE MODULE Router_Flow_Mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL initLog4j(external_var) INTO var1;
		CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN FALSE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;

		DECLARE CID INTEGER InputRoot.Properties.CodedCharSetId;
		DECLARE Encod INTEGER InputRoot.Properties.Encoding;
		DECLARE in_data, out_data CHARACTER;
		DECLARE Service_Url CHARACTER;
		DECLARE Service_Code INTEGER;
		DECLARE segmentIndex INTEGER 2;
		DECLARE currentSegment CHAR;
		SET in_data = CAST(ASBITSTREAM(InputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);
		SET Service_Code = InputRoot.HTTPInputHeader.Service_code; ----Service_Code in http Header

		DECLARE r ROW;
		DECLARE query CHARACTER;
		SET query = 'select SERVICE_URL, Parameter from SERVICES_TABLE where SERVICE_CODE=?';
		set r.res[] = PASSTHRU(query, Service_Code);


		IF r.res.SERVICE_URL IS NOT NULL THEN
			SET Service_Url = r.res.SERVICE_URL;
		ELSE
			SET OutputRoot.JSON.Data.Error = 'Service_Code is Invalid';
			propagate to TERMINAL 'Failure';
		END IF;
		-- SET OutputRoot = InputRoot;

		DECLARE idParam CHAR;
		-- SET idParam = InputRoot.HTTPInputHeader."X-Query-String";
		-- SET OutputLocalEnvironment.Destination.HTTP.RequestURL = Service_Url || idParam;


		IF r.res.PARAMETER = 'body' THEN
			SET OutputRoot.JSON.Data.success = 'body';
			SET OutputRoot.JSON.Data = InputRoot.JSON.Data;
			SET OutputLocalEnvironment.Destination.HTTP.RequestURL = Service_Url ;
			SET out_data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);


			propagate to TERMINAL 'out';



		ELSEIF r.res.PARAMETER = 'path' THEN
			SET OutputRoot.JSON.Data.success = 'path';
			DECLARE lovEnv REFERENCE TO InputLocalEnvironment.HTTP.Input.Path.Segment[2];

			WHILE LASTMOVE(lovEnv) DO
				SET currentSegment = lovEnv;

				SET Service_Url = Service_Url || '/' || currentSegment;

				MOVE lovEnv NEXTSIBLING;
				SET OutputLocalEnvironment.Destination.HTTP.RequestURL = Service_Url;


			END WHILE;
			SET out_data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);


			propagate to TERMINAL 'out';


		ELSEIF r.res.PARAMETER = 'query' THEN
			SET OutputRoot.JSON.Data.success = 'query';
			SET idParam = InputRoot.HTTPInputHeader."X-Query-String";
			SET OutputLocalEnvironment.Destination.HTTP.RequestURL = Service_Url || idParam;
			SET out_data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);

			propagate to TERMINAL 'out';


		ELSE
			SET OutputRoot.JSON.Data.Error = 'Service_Code is Invalid';
			SET out_data = CAST(ASBITSTREAM(OutputRoot.JSON.Data CCSID CID) AS CHARACTER CCSID CID ENCODING Encod);

			propagate to TERMINAL 'Failure';
		END IF;
		CALL WriteLogFile(MessageFlowLabel, 'Router_In', 'INFO','Input_Data: ' || in_data) INTO var1;
		CALL WriteLogFile(MessageFlowLabel, 'Router_Out', 'INFO', 'Output_Data: ' || out_data) INTO var1;


	END;
END MODULE;