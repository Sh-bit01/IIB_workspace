



CREATE COMPUTE MODULE Service_ListCardDetails_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE cardId CHARACTER;
		DECLARE r ROW;
		DECLARE query CHARACTER;

		SET cardId = InputLocalEnvironment.HTTP.Input.QueryString.cardId;

		IF LENGTH(cardId)=16 THEN
			SET query = 'select * from CARD_DETAILS Where CARD_ID=?';
			set r.res[] = PASSTHRU(query, cardId);
		ELSE
			THROW USER EXCEPTION VALUES('com.sbm.eidiko.HTTPGatewayReq_FramingAPICallReq.Main, Message Id length is not equal to 16. Please pass the valid lengthMessage Id length is not equal to 16. Please pass the valid length');	
		END IF;
		




		IF r.res.CARD_ID IS NOT NULL THEN
			SET OutputRoot.JSON.Data.status_code = '200';
			SET OutputRoot.JSON.Data.data[] = r.res[];

		ELSE
			--SET OutputRoot.JSON.Data.error = 'No card details found for the provided card ID.';

			THROW USER EXCEPTION CATALOG 'BIPmsgs' MESSAGE
			2951 VALUES('') ;

		END IF;


	END;
END MODULE;