BROKER SCHEMA Exception_handling


CREATE COMPUTE MODULE Exception_Handling_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE ref REFERENCE TO InputExceptionList.*[1];
		DECLARE Text CHARACTER;
		DECLARE Itm ROW;
		WHILE LASTMOVE(ref) DO
			MOVE ref LASTCHILD;
			IF ref.Number IS NOT NULL THEN
				SET Text = ref.Text;
				SET Itm.item[] = ref.Insert[];
			END IF;
		END WHILE;

		SET OutputRoot.JSON.Data.Error = Text;
		-- Set a new field in OutputRoot.JSON.Data.Error
		SET OutputRoot.JSON.Data.Error.esb_error_desc = Itm.*[<].*[<];
		-- SET OutputRoot.JSON.Data.Error.Item =


	END;
END MODULE;