

CREATE COMPUTE MODULE pdf_write_data_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		
		
		
		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.Properties.ContentType = 'application/pdf';
		SET OutputRoot.HTTPInputHeader = InputRoot.HTTPInputHeader;
		SET OutputRoot.HTTPInputHeader."Content-Type" = 'application/pdf';
		--DECLARE data CHARACTER CAST(InputRoot.BLOB.BLOB AS CHARACTER CCSID InputRoot.Properties.CodedCharSetId ENCODING InputRoot.Properties.Encoding);
		DECLARE blo BLOB;
		DECLARE img CHARACTER;
		
		DECLARE In_url CHARACTER InputRoot.JSON.Data.url;
		SET img = 'https://picsum.photos/seed/'||UUIDASCHAR||'/400/400';
		
		SET blo = pdfI(InputRoot.JSON.Data.data, COALESCE(In_url, img));
		
		SET OutputRoot.BLOB.BLOB = blo;
		
		
		
		
	END;
END MODULE;


CREATE PROCEDURE pdf(in data CHARACTER) RETURNS BLOB
LANGUAGE JAVA
EXTERNAL NAME "gen.PdfUtil.generatePdfAsBytes";



CREATE PROCEDURE pdfI(in data CHARACTER, in img CHARACTER) RETURNS BLOB
LANGUAGE JAVA
EXTERNAL NAME "gen.PdfUtil.generatePdfWithTextAndImage";



